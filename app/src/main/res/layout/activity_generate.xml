<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/back"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/sd_title"
                android:textColor="@color/fg"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- model picker -->
        <TextView style="@style/Label" android:layout_marginTop="12dp" android:text="@string/sd_model" />

        <Button
            android:id="@+id/modelPick"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/modelDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- one-time model download -->
        <LinearLayout
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/stage_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/setupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dlStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/dlProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:visibility="invisible"
                app:indicatorColor="@color/after" />

            <Button
                android:id="@+id/download"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/sd_download" />
        </LinearLayout>

        <!-- generator -->
        <LinearLayout
            android:id="@+id/createPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/stage_bg">

                <com.nitido.app.SquareImageView
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/genProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:max="1000"
                    android:visibility="invisible"
                    app:indicatorColor="@color/after" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/baseThumb"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/stage_bg"
                    android:contentDescription="@string/sd_base"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/pickBase"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sd_pick_base" />

                <Button
                    android:id="@+id/clearBase"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sd_clear_base"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/zoneRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/paintZone"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/paint_zone" />

                <Button
                    android:id="@+id/clearZone"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paint_zone_clear"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- how much the photo may change (normal models) -->
            <LinearLayout
                android:id="@+id/strengthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/sd_strength" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/strength"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:value="55"
                    android:valueFrom="20"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/strengthValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <!-- how much to keep the photo (instruction editor) -->
            <LinearLayout
                android:id="@+id/keepRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/sd_keep" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/keep"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="0.1"
                    android:value="1.5"
                    android:valueFrom="1.0"
                    android:valueTo="2.5" />

                <TextView
                    android:id="@+id/keepValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <TextView
                android:id="@+id/photoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/formatRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Label" android:text="@string/sd_format" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/formatGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/fmtSquare"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/fmtSquare"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fmt_square" />

                    <Button
                        android:id="@+id/fmtPortrait"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fmt_portrait" />

                    <Button
                        android:id="@+id/fmtLandscape"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fmt_landscape" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/formatNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fmt_fixed_note"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bigSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sd_big_size"
                android:textColor="@color/fg"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/promptLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/sd_prompt_hint"
                app:helperText="@string/sd_prompt_help">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/weightsTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sd_weights_tip"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/negativeLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/sd_negative_hint"
                app:helperText="@string/sd_negative_help">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/negative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:text="@string/sd_negative_default" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/sd_steps" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/steps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="1"
                    android:value="25"
                    android:valueFrom="8"
                    android:valueTo="150" />

                <TextView
                    android:id="@+id/stepsValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/sd_guidance" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/guidance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="0.5"
                    android:value="7.0"
                    android:valueFrom="3.0"
                    android:valueTo="12.0" />

                <TextView
                    android:id="@+id/guidanceValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="@string/sd_sampler" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/samplerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/smpDpm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/smpDpm"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sd_sampler_dpm" />

                <Button
                    android:id="@+id/smpPlms"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sd_sampler_plms" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/backendGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/sdGpu"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/sdGpu"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GPU" />

                <Button
                    android:id="@+id/sdCpu"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CPU" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/hqTimelapse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sd_hq_timelapse"
                android:textColor="@color/fg" />

            <Button
                android:id="@+id/generate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/sd_generate" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/upscale"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/sd_upscale" />

                <Button
                    android:id="@+id/save"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/after"
                    android:text="@string/save"
                    android:textColor="#1B1204" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playTimelapse"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/sd_play" />

                <Button
                    android:id="@+id/saveTimelapse"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sd_save_video" />
            </LinearLayout>

            <Button
                android:id="@+id/refine"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:text="@string/sd_refine" />

            <Button
                android:id="@+id/useResult"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sd_use_result" />

            <TextView
                android:id="@+id/genStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteModel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/muted"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
