<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/back"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/restore_title"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/stage_bg">

        <com.nitido.app.CompareView
            android:id="@+id/compare"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:max="1000"
            android:visibility="invisible" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/packCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/packInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_pack_info"
                    android:textColor="@color/fg"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/packDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_pack_download" />
            </LinearLayout>

            <Button
                android:id="@+id/pick"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pick" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optCrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/restore_crop"
                android:textColor="@color/fg" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/restore_color"
                android:textColor="@color/fg" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optDenoise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/restore_denoise"
                android:textColor="@color/fg" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optDeblur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/restore_deblur"
                android:textColor="@color/fg" />

            <LinearLayout
                android:id="@+id/sharpRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/restore_sharp_amount" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sharpAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:value="80"
                    android:valueFrom="20"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/sharpValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optFaces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/restore_faces"
                android:textColor="@color/fg" />

            <LinearLayout
                android:id="@+id/fidelityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/restore_fidelity" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/fidelity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:value="70"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <TextView
                    android:id="@+id/fidelityValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_fidelity_hint"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optColorize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_colorize"
                android:textColor="@color/fg" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_detail"
                android:textColor="@color/fg" />

            <LinearLayout
                android:id="@+id/detailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/restore_detail_amount" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/detailAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="5"
                    android:value="25"
                    android:valueFrom="10"
                    android:valueTo="50" />

                <TextView
                    android:id="@+id/detailValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/fg" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/marks"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/restore_marks" />

                <Button
                    android:id="@+id/marksClear"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paint_zone_clear"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="@string/label_scale" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/scaleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/rScale2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/rScale1"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1×" />

                <Button
                    android:id="@+id/rScale2"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2×" />

                <Button
                    android:id="@+id/rScale4"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4×" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optGpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/restore_gpu"
                android:textColor="@color/fg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/go"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/restore_go" />

                <Button
                    android:id="@+id/save"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/save" />
            </LinearLayout>

            <TextView
                android:id="@+id/estimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/fg"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
