<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla mientras se procesa (opción A): solo la foto en vivo, el avance y el monitor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/procRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/procTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/procStop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/stage_bg">

        <ImageView
            android:id="@+id/procPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/proc_preview"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="#99000000"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@string/proc_live"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/procPiece"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="#99000000"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/procStep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/procStepCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/procBarStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="1000"
        app:indicatorColor="@color/accent"
        app:trackCornerRadius="7dp"
        app:trackThickness="14dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/procBarTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="1000"
        app:indicatorColor="@color/after"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/ProcLabel" android:text="@string/proc_step_pct" />

            <TextView
                android:id="@+id/procStepPct"
                style="@style/ProcValue"
                android:textColor="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/ProcLabel" android:text="@string/proc_total_pct" />

            <TextView
                android:id="@+id/procTotalPct"
                style="@style/ProcValue"
                android:textColor="@color/after" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView style="@style/ProcLabel" android:text="@string/proc_eta" />

            <TextView
                android:id="@+id/procEta"
                style="@style/ProcValue" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/stage_bg"
        android:columnCount="2"
        android:padding="12dp">

        <LinearLayout style="@style/ProcCell">
            <LinearLayout style="@style/ProcRow">
                <TextView style="@style/ProcCellName" android:text="@string/proc_mem" />
                <TextView android:id="@+id/monMem" style="@style/ProcCellValue" />
            </LinearLayout>
            <ProgressBar android:id="@+id/monMemBar" style="@style/ProcMeter" />
            <TextView android:id="@+id/monMemNote" style="@style/ProcCellNote" />
        </LinearLayout>

        <LinearLayout style="@style/ProcCell">
            <LinearLayout style="@style/ProcRow">
                <TextView style="@style/ProcCellName" android:text="@string/proc_cpu" />
                <TextView android:id="@+id/monCpu" style="@style/ProcCellValue" />
            </LinearLayout>
            <ProgressBar android:id="@+id/monCpuBar" style="@style/ProcMeter" />
            <TextView android:id="@+id/monCpuNote" style="@style/ProcCellNote" />
        </LinearLayout>

        <LinearLayout style="@style/ProcCell">
            <LinearLayout style="@style/ProcRow">
                <TextView style="@style/ProcCellName" android:text="@string/proc_gpu" />
                <TextView android:id="@+id/monGpu" style="@style/ProcCellValue" />
            </LinearLayout>
            <ProgressBar android:id="@+id/monGpuBar" style="@style/ProcMeter" />
            <TextView android:id="@+id/monGpuNote" style="@style/ProcCellNote" />
        </LinearLayout>

        <LinearLayout style="@style/ProcCell">
            <LinearLayout style="@style/ProcRow">
                <TextView style="@style/ProcCellName" android:text="@string/proc_temp" />
                <TextView android:id="@+id/monTemp" style="@style/ProcCellValue" />
            </LinearLayout>
            <ProgressBar android:id="@+id/monTempBar" style="@style/ProcMeter" />
            <TextView android:id="@+id/monTempNote" style="@style/ProcCellNote" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
